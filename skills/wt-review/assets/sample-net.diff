+import type { Recipe, Ingredient, Step } from "./types";
+
+/** 1 ページに収める手順の目安。これを超えたら改ページのヒントを入れる。 */
+const STEPS_PER_PAGE = 8;
+
+export type PrintOptions = {
+  /** 材料の分量を人数分でスケールする。既定はレシピの既定人数。 */
+  servings?: number;
+  /** メモ欄を末尾に付ける。 */
+  withNotes?: boolean;
+};
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;");
+}
+
+/**
+ * 分量をスケールする。1/3 のような分数表記はそのまま返す
+ * (印刷では「適量」「少々」と同じく人間が読む前提)。
+ */
+export function scaleAmount(amount: string, factor: number): string {
+  if (factor === 1) {
+    return amount;
+  }
+  const match = /^(\d+(?:\.\d+)?)\s*(.*)$/.exec(amount);
+  if (!match) {
+    return amount;
+  }
+  const scaled = Number(match[1]) * factor;
+  const rounded = Math.round(scaled * 10) / 10;
+  return `${rounded}${match[2] ? ` ${match[2]}` : ""}`;
+}
+
+function renderIngredients(items: Ingredient[], factor: number): string {
+  const rows = items
+    .map(
+      (item) => `
+      <tr>
+        <th scope="row">${escapeHtml(item.name)}</th>
+        <td>${escapeHtml(scaleAmount(item.amount, factor))}</td>
+      </tr>`,
+    )
+    .join("");
+  return `
+    <table class="print-ingredients">
+      <caption>材料</caption>
+      <tbody>${rows}
+      </tbody>
+    </table>`;
+}
+
+function renderSteps(steps: Step[]): string {
+  const items = steps
+    .map((step, index) => {
+      const breakBefore = index > 0 && index % STEPS_PER_PAGE === 0;
+      const cls = breakBefore ? ' class="print-step print-break"' : ' class="print-step"';
+      const timer = step.minutes ? `<span class="print-timer">${step.minutes} 分</span>` : "";
+      return `
+        <li${cls}>
+          <p class="print-step-body">${escapeHtml(step.body)}</p>
+          ${timer}
+        </li>`;
+    })
+    .join("");
+  return `
+    <ol class="print-steps">${items}
+    </ol>`;
+}
+
+export function renderPrintView(recipe: Recipe, options: PrintOptions = {}): string {
+  const servings = options.servings ?? recipe.servings;
+  const factor = servings / recipe.servings;
+  const notes = options.withNotes
+    ? '<section class="print-notes"><h2>メモ</h2><div class="print-notes-lines"></div></section>'
+    : "";
+  return `
+    <article class="print-recipe">
+      <header class="print-head">
+        <h1>${escapeHtml(recipe.title)}</h1>
+        <p class="print-meta">${servings} 人分 · 調理 ${recipe.totalMinutes} 分</p>
+      </header>
+      ${renderIngredients(recipe.ingredients, factor)}
+      <h2>手順</h2>
+      ${renderSteps(recipe.steps)}
+      ${notes}
+    </article>`;
+}
