@@ -0,0 +1,213 @@
+/* 印刷専用のスタイル。画面表示には読み込まない。 */
+
+@page {
+  size: A4;
+  margin: 18mm 16mm 20mm;
+}
+
+@page :first {
+  margin-top: 14mm;
+}
+
+:root {
+  --print-ink: #111111;
+  --print-muted: #555555;
+  --print-rule: #cccccc;
+  --print-accent: #7a3b12;
+}
+
+.print-recipe {
+  max-width: 170mm;
+  margin: 0 auto;
+  color: var(--print-ink);
+  font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
+  font-size: 10.5pt;
+  line-height: 1.7;
+}
+
+.print-recipe * {
+  box-sizing: border-box;
+}
+
+.print-head {
+  padding-bottom: 6mm;
+  margin-bottom: 8mm;
+  border-bottom: 1.5pt solid var(--print-ink);
+}
+
+.print-head h1 {
+  margin: 0;
+  font-size: 20pt;
+  font-weight: 600;
+  line-height: 1.35;
+  letter-spacing: 0.01em;
+}
+
+.print-meta {
+  margin: 2mm 0 0;
+  color: var(--print-muted);
+  font-size: 9pt;
+  letter-spacing: 0.04em;
+}
+
+.print-recipe h2 {
+  margin: 8mm 0 3mm;
+  font-size: 12pt;
+  font-weight: 600;
+  letter-spacing: 0.02em;
+}
+
+.print-recipe h2::after {
+  display: block;
+  width: 12mm;
+  height: 1pt;
+  margin-top: 1.5mm;
+  background: var(--print-accent);
+  content: "";
+}
+
+/* ---------- 材料 ---------- */
+
+.print-ingredients {
+  width: 100%;
+  margin: 0 0 6mm;
+  border-collapse: collapse;
+  page-break-inside: avoid;
+  break-inside: avoid;
+}
+
+.print-ingredients caption {
+  margin-bottom: 3mm;
+  font-size: 12pt;
+  font-weight: 600;
+  text-align: left;
+  letter-spacing: 0.02em;
+}
+
+.print-ingredients tr {
+  border-bottom: 0.5pt dotted var(--print-rule);
+}
+
+.print-ingredients tr:last-child {
+  border-bottom: none;
+}
+
+.print-ingredients th {
+  padding: 1.6mm 2mm 1.6mm 0;
+  font-weight: 400;
+  text-align: left;
+  vertical-align: baseline;
+}
+
+.print-ingredients td {
+  width: 32mm;
+  padding: 1.6mm 0;
+  text-align: right;
+  vertical-align: baseline;
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+/* ---------- 手順 ---------- */
+
+.print-steps {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  counter-reset: print-step;
+}
+
+.print-step {
+  position: relative;
+  padding: 0 0 4mm 10mm;
+  counter-increment: print-step;
+  page-break-inside: avoid;
+  break-inside: avoid;
+}
+
+.print-step::before {
+  position: absolute;
+  top: 0.4mm;
+  left: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 6.5mm;
+  height: 6.5mm;
+  border: 0.8pt solid var(--print-ink);
+  border-radius: 50%;
+  font-size: 8.5pt;
+  font-variant-numeric: tabular-nums;
+  content: counter(print-step);
+}
+
+.print-step:last-child {
+  padding-bottom: 0;
+}
+
+.print-step-body {
+  margin: 0;
+  text-align: justify;
+  text-justify: inter-ideograph;
+}
+
+.print-timer {
+  display: inline-block;
+  margin-top: 1.2mm;
+  padding: 0.4mm 2mm;
+  border: 0.5pt solid var(--print-rule);
+  color: var(--print-muted);
+  font-size: 8.5pt;
+  letter-spacing: 0.04em;
+  white-space: nowrap;
+}
+
+.print-break {
+  page-break-before: always;
+  break-before: page;
+}
+
+/* ---------- メモ欄 ---------- */
+
+.print-notes {
+  margin-top: 10mm;
+  page-break-inside: avoid;
+  break-inside: avoid;
+}
+
+.print-notes-lines {
+  height: 32mm;
+  background-image: repeating-linear-gradient(
+    to bottom,
+    transparent 0,
+    transparent 7mm,
+    var(--print-rule) 7mm,
+    var(--print-rule) calc(7mm + 0.4pt)
+  );
+}
+
+/* ---------- 画面には出さない ---------- */
+
+@media screen {
+  .print-recipe {
+    display: none;
+  }
+}
+
+@media print {
+  nav,
+  footer,
+  .app-header,
+  .recipe-actions,
+  .toast {
+    display: none !important;
+  }
+
+  a[href]::after {
+    content: "";
+  }
+
+  .print-recipe {
+    display: block;
+  }
+}
