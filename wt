#!/usr/bin/env bash
# wt — a CLI for parallel development sessions using git worktree + herdr workspace
#
# Usage (run from anywhere inside the target repository):
#   wt new <task> [--base <ref>] [--no-claude]
#       Create a worktree at ~/.herdr/worktrees/<repo>/<task>, open a herdr
#       workspace, bootstrap, and launch Claude Code
#       (defaults to the main checkout's current branch if --base is omitted)
#   wt bootstrap [<path>]
#       Fill in gitignored files missing from an existing worktree.
#       Also works with .claude/worktrees/* created by Claude Code
#   wt open <task>
#       Reopen an existing worktree as a herdr workspace
#   wt list
#       Show worktrees and their corresponding herdr workspaces
#   wt rm <task> [--force]
#       Remove worktree / workspace / branch (aborts if there are uncommitted changes)
#
# Bootstrap common steps: symlink .env from the main checkout, copy
# .claude/settings.local.json. Repo-specific setup (secrets symlinking,
# DB copies, native rebuilds, etc.) goes in the repo's scripts/worktree-setup
# (must be executable). When the hook exists, wt delegates everything
# (including dependency installation) to it, passing cwd=worktree,
# WT_MAIN_ROOT and WT_TARGET as environment variables. Without the hook,
# wt detects the package manager from lockfiles and installs dependencies.
set -euo pipefail

WT_HOME="${WT_HOME:-$HOME/.herdr/worktrees}"
WT_LANG="${WT_LANG:-en}"

# ---------------------------------------------------------------------------
# i18n message catalog
# ---------------------------------------------------------------------------
msg() {
  local key="$1"; shift
  case "$WT_LANG" in
    ja) msg_ja "$key" "$@" ;;
    *)  msg_en "$key" "$@" ;;
  esac
}

msg_en() {
  local key="$1"; shift
  case "$key" in
    not_in_repo)        printf 'must be run inside a git repository: %s' "$1" ;;
    skip_real_file)     printf 'skip: %s is a real file, not overwriting' "$1" ;;
    link_created)       printf 'link: %s -> %s' "$1" "$2" ;;
    no_lockfile)        printf 'no lockfile found, skipping dependency install' ;;
    not_linked_wt)      printf '%s is not a linked worktree' "$1" ;;
    main_no_bootstrap)  printf 'bootstrap is not needed for the main checkout' ;;
    copy_settings)      printf 'copy: .claude/settings.local.json' ;;
    running_hook)       printf 'running repo hook: scripts/worktree-setup' ;;
    installing_deps)    printf 'installing dependencies… (%s)' "$1" ;;
    bootstrap_done)     printf 'bootstrap complete: %s' "$1" ;;
    unknown_option)     printf '%s: unknown option %s' "$1" "$2" ;;
    too_many_args)      printf '%s: too many arguments' "$1" ;;
    branch_exists)      printf 'branch %s already exists (use wt open %s to reopen)' "$1" "$1" ;;
    base_not_found)     printf 'base ref not found: %s' "$1" ;;
    created_wt_ws)      printf 'worktree + workspace %s created: %s (%s ← %s)' "$1" "$2" "$3" "$4" ;;
    herdr_fallback)     printf 'cannot connect to herdr server, creating git worktree only' ;;
    claude_started)     printf 'Claude Code started in workspace %s' "$1" ;;
    ready)              printf 'ready: %s' "$1" ;;
    herdr_unavailable)  printf 'cannot connect to herdr server' ;;
    opened_ws)          printf 'opened in workspace %s: %s' "$1" "$2" ;;
    wt_not_found)       printf 'worktree for branch %s not found' "$1" ;;
    cannot_rm_main)     printf 'cannot remove the main checkout' ;;
    uncommitted)        printf '%s has uncommitted changes (use --force to force removal)' "$1" ;;
    removed_ws_wt)      printf 'removed workspace %s and worktree' "$1" ;;
    removed_wt)         printf 'removed worktree: %s' "$1" ;;
    branch_unmerged)    printf 'branch %s is unmerged, keeping it (use git branch -D %s to delete)' "$1" "$1" ;;
    unknown_subcmd)     printf 'unknown subcommand: %s (see --help)' "$1" ;;
    *) printf '%s' "$key" ;;
  esac
}

msg_ja() {
  local key="$1"; shift
  case "$key" in
    not_in_repo)        printf 'git リポジトリ内で実行する必要がある: %s' "$1" ;;
    skip_real_file)     printf 'skip: %s は実体があるため触らない' "$1" ;;
    link_created)       printf 'link: %s -> %s' "$1" "$2" ;;
    no_lockfile)        printf 'lockfile が見つからないため依存インストールをスキップした' ;;
    not_linked_wt)      printf '%s は linked worktree ではない' "$1" ;;
    main_no_bootstrap)  printf '本体 checkout に bootstrap は不要' ;;
    copy_settings)      printf 'copy: .claude/settings.local.json' ;;
    running_hook)       printf 'repo フック実行中: scripts/worktree-setup' ;;
    installing_deps)    printf '依存インストール中… (%s)' "$1" ;;
    bootstrap_done)     printf 'bootstrap 完了: %s' "$1" ;;
    unknown_option)     printf '%s: 不明なオプション %s' "$1" "$2" ;;
    too_many_args)      printf '%s: 引数が多すぎる' "$1" ;;
    branch_exists)      printf 'ブランチ %s は既に存在する (wt open %s で開き直せる)' "$1" "$1" ;;
    base_not_found)     printf 'base ref が見つからない: %s' "$1" ;;
    created_wt_ws)      printf 'worktree + workspace %s 作成: %s (%s ← %s)' "$1" "$2" "$3" "$4" ;;
    herdr_fallback)     printf 'herdr サーバに接続できないため git worktree のみ作成する' ;;
    claude_started)     printf 'Claude Code を workspace %s で起動した' "$1" ;;
    ready)              printf '準備完了: %s' "$1" ;;
    herdr_unavailable)  printf 'herdr サーバに接続できない' ;;
    opened_ws)          printf 'workspace %s で開いた: %s' "$1" "$2" ;;
    wt_not_found)       printf 'ブランチ %s の worktree が見つからない' "$1" ;;
    cannot_rm_main)     printf '本体 checkout は削除できない' ;;
    uncommitted)        printf '%s に未コミットの変更がある (--force で強制削除)' "$1" ;;
    removed_ws_wt)      printf 'workspace %s と worktree を削除した' "$1" ;;
    removed_wt)         printf 'worktree を削除した: %s' "$1" ;;
    branch_unmerged)    printf 'ブランチ %s は未マージのため残した (git branch -D %s で削除可)' "$1" "$1" ;;
    unknown_subcmd)     printf '不明なサブコマンド: %s (--help 参照)' "$1" ;;
    *) printf '%s' "$key" ;;
  esac
}

# ---------------------------------------------------------------------------

log() { printf '[wt] %s\n' "$*"; }
die() {
  printf '[wt] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"
  exit "${1:-0}"
}

resolve_repo() {
  local from="${1:-$PWD}"
  MAIN_ROOT="$(dirname "$(git -C "$from" rev-parse --path-format=absolute --git-common-dir)")" ||
    die "$(msg not_in_repo "$from")"
  REPO_NAME="$(basename "$MAIN_ROOT")"
  WT_DIR="$WT_HOME/$REPO_NAME"
}

herdr_ok() {
  command -v herdr >/dev/null 2>&1 && herdr workspace list >/dev/null 2>&1
}

link_shared() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    log "$(msg skip_real_file "$dst")"
    return 0
  fi
  ln -sfn "$src" "$dst"
  log "$(msg link_created "$dst" "$src")"
}

install_deps() {
  local target="$1"
  if [ -f "$target/package-lock.json" ]; then
    (cd "$target" && npm ci --prefer-offline --no-audit --no-fund)
  elif [ -f "$target/pnpm-lock.yaml" ]; then
    (cd "$target" && pnpm install --frozen-lockfile)
  elif [ -f "$target/yarn.lock" ]; then
    (cd "$target" && yarn install --immutable)
  elif [ -f "$target/bun.lock" ] || [ -f "$target/bun.lockb" ]; then
    (cd "$target" && bun install --frozen-lockfile)
  elif [ -f "$target/uv.lock" ]; then
    (cd "$target" && uv sync)
  else
    log "$(msg no_lockfile)"
  fi
}

cmd_bootstrap() {
  local target="${1:-$PWD}"
  target="$(cd "$target" && pwd)"
  resolve_repo "$target"

  [ -f "$target/.git" ] || die "$(msg not_linked_wt "$target")"
  [ "$target" != "$MAIN_ROOT" ] || die "$(msg main_no_bootstrap)"

  link_shared "$MAIN_ROOT/.env" "$target/.env"

  if [ -f "$MAIN_ROOT/.claude/settings.local.json" ] && [ ! -e "$target/.claude/settings.local.json" ]; then
    mkdir -p "$target/.claude"
    cp "$MAIN_ROOT/.claude/settings.local.json" "$target/.claude/"
    log "$(msg copy_settings)"
  fi

  if [ -x "$target/scripts/worktree-setup" ]; then
    log "$(msg running_hook)"
    (cd "$target" && WT_MAIN_ROOT="$MAIN_ROOT" WT_TARGET="$target" scripts/worktree-setup)
  else
    if [ ! -d "$target/node_modules" ]; then
      log "$(msg installing_deps "$target")"
      install_deps "$target"
    fi
  fi
  log "$(msg bootstrap_done "$target")"
}

cmd_new() {
  local task="" base="" start_claude=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)
        base="$2"
        shift
        ;;
      --no-claude) start_claude=0 ;;
      -*) die "$(msg unknown_option new "$1")" ;;
      *) [ -z "$task" ] && task="$1" || die "$(msg too_many_args new)" ;;
    esac
    shift
  done
  [ -n "$task" ] || usage 1
  resolve_repo

  if [ -z "$base" ]; then
    base="$(git -C "$MAIN_ROOT" symbolic-ref --short -q HEAD || echo HEAD)"
  fi
  git -C "$MAIN_ROOT" rev-parse --verify --quiet "refs/heads/$task" >/dev/null &&
    die "$(msg branch_exists "$task")"
  git -C "$MAIN_ROOT" rev-parse --verify --quiet "$base^{commit}" >/dev/null ||
    die "$(msg base_not_found "$base")"

  local path="$WT_DIR/$task" ws=""
  if herdr_ok; then
    local out
    out="$(herdr worktree create --cwd "$MAIN_ROOT" --branch "$task" --base "$base" \
      --path "$path" --label "$task" --no-focus --json)"
    ws="$(jq -r '.result.workspace.workspace_id' <<<"$out")"
    path="$(jq -r '.result.worktree.path' <<<"$out")"
    log "$(msg created_wt_ws "$ws" "$path" "$task" "$base")"
  else
    log "$(msg herdr_fallback)"
    git -C "$MAIN_ROOT" worktree add -b "$task" "$path" "$base"
  fi

  cmd_bootstrap "$path"

  if [ -n "$ws" ] && [ "$start_claude" -eq 1 ]; then
    herdr agent start "claude-$task" --workspace "$ws" --cwd "$path" --no-focus -- claude
    herdr workspace focus "$ws" >/dev/null
    log "$(msg claude_started "$ws")"
  fi
  log "$(msg ready "$path")"
}

cmd_open() {
  local task="${1:-}"
  [ -n "$task" ] || usage 1
  resolve_repo
  herdr_ok || die "$(msg herdr_unavailable)"
  local out ws
  out="$(herdr worktree open --cwd "$MAIN_ROOT" --branch "$task" --label "$task" --no-focus --json)"
  ws="$(jq -r '.result.workspace.workspace_id' <<<"$out")"
  herdr workspace focus "$ws" >/dev/null
  log "$(msg opened_ws "$ws" "$task")"
}

cmd_list() {
  resolve_repo
  git -C "$MAIN_ROOT" worktree list
  if herdr_ok; then
    echo "--- herdr workspaces ---"
    herdr worktree list --cwd "$MAIN_ROOT" --json |
      jq -r '.result.worktrees[] | select(.open_workspace_id) | "\(.open_workspace_id)\t\(.branch)\t\(.path)"'
  fi
}

cmd_rm() {
  local task="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      -*) die "$(msg unknown_option rm "$1")" ;;
      *) task="$1" ;;
    esac
    shift
  done
  [ -n "$task" ] || usage 1
  resolve_repo

  local path
  path="$(git -C "$MAIN_ROOT" worktree list --porcelain |
    awk -v b="refs/heads/$task" '$1=="worktree"{p=$2} $1=="branch" && $2==b{print p}')"
  [ -n "$path" ] || die "$(msg wt_not_found "$task")"
  [ "$path" != "$MAIN_ROOT" ] || die "$(msg cannot_rm_main)"

  if [ "$force" -eq 0 ] && [ -n "$(git -C "$path" status --porcelain)" ]; then
    die "$(msg uncommitted "$path")"
  fi

  local ws=""
  if herdr_ok; then
    ws="$(herdr worktree list --cwd "$MAIN_ROOT" --json |
      jq -r --arg p "$path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty')"
  fi
  if [ -n "$ws" ]; then
    if [ "$force" -eq 1 ]; then
      herdr worktree remove --workspace "$ws" --force --json >/dev/null
    else
      herdr worktree remove --workspace "$ws" --json >/dev/null
    fi
    log "$(msg removed_ws_wt "$ws")"
  else
    if [ "$force" -eq 1 ]; then
      git -C "$MAIN_ROOT" worktree remove --force "$path"
    else
      git -C "$MAIN_ROOT" worktree remove "$path"
    fi
    log "$(msg removed_wt "$path")"
  fi

  local del_flag="-d"
  [ "$force" -eq 1 ] && del_flag="-D"
  git -C "$MAIN_ROOT" branch "$del_flag" "$task" ||
    log "$(msg branch_unmerged "$task")"
}

case "${1:-}" in
  new)
    shift
    cmd_new "$@"
    ;;
  bootstrap)
    shift
    cmd_bootstrap "$@"
    ;;
  open)
    shift
    cmd_open "$@"
    ;;
  list)
    shift
    cmd_list "$@"
    ;;
  rm)
    shift
    cmd_rm "$@"
    ;;
  -h | --help | "") usage ;;
  *) die "$(msg unknown_subcmd "$1")" ;;
esac
