#!/usr/bin/env bash
# wt — git worktree + herdr workspace で並列開発セッションを立ち上げる汎用 CLI
#
# 使い方 (対象リポジトリ内の任意の場所から実行する):
#   wt new <task> [--base <ref>] [--no-claude] [--prompt <text>|--prompt-file <path>]
#       worktree を <repo>/.claude/worktrees/<task> (ブランチ worktree-<task>) に作り、
#       herdr workspace を開き、bootstrap 後に Claude Code を起動する。
#       base 省略時は本体の現在ブランチ。WT_HOME を設定すると従来の集約置き場に作る。
#       --prompt / --prompt-file は起動する Claude への初期プロンプト (要 herdr)。
#       claude には既定で --model opus --permission-mode auto を渡す
#       (WT_CLAUDE_ARGS で差し替え、空文字でフラグ無し。空白を含む値は不可)
#   wt bootstrap [<path>]
#       既存 worktree に gitignore されて入らないファイルを補完する。
#       Claude Code が作る .claude/worktrees/* にも使える
#   wt open <task>
#       既存 worktree を herdr workspace として開き直す
#   wt browse <path>
#       ローカルファイルを既定のアプリ (HTML ならブラウザ) で開く。
#       WSL / macOS / Linux の差を吸収する。skill が生成したレビューページを
#       開くのに使う。開く手段が無ければパスを表示して失敗する
#   wt list
#       worktree と herdr workspace の対応を一覧表示
#   wt peers [--json]
#       この repo の Claude Code セッション (本体 / 各 worktree) を一覧表示する。
#       name 列がセッション間メッセージ (SendMessage) の宛先。(self) は自分。
#       worktree 側は wt new が付ける固定名 wt-<task> になる (要 jq)
#   wt merge [<task>] [--no-check]
#       ブランチ worktree-<task> を本体の現在ブランチへマージする。
#       worktree 内から task 省略で自分を対象にできる。コンフリクトは本体に残す。
#       worktree に scripts/check (実行可能) があればマージ前に実行し、
#       失敗したらマージしない (--no-check で省略)
#   wt rm [<task>] [--force]
#       worktree / workspace / ブランチを削除 (未コミット変更があれば中断)。
#       worktree 内から task 省略で自分を片付けられる (workspace close は最後)
#
# bootstrap の共通処理: .worktreeinclude (gitignore 構文) に列挙されたファイルを
# 本体から実体コピー (既存は上書きしない)、.env を本体へ symlink、
# .claude/settings.local.json をコピー。
# リポジトリ固有の準備 (secrets の symlink、DB コピー、native rebuild 等) は
# repo 側の scripts/worktree-setup (実行可能ファイル) に書く。存在すれば依存
# インストール含めそちらに委譲し (cwd=worktree、WT_MAIN_ROOT / WT_TARGET を渡す)、
# 無ければ lockfile から検出した package manager で依存をインストールする。
set -euo pipefail

# 既定では worktree を <repo>/.claude/worktrees/<task> に作り、Claude Code の native
# worktree (ブランチ worktree-<task>) と物理位置・命名を揃える。WT_HOME を設定すると
# 従来の集約置き場 $WT_HOME/<repo>/<task> に作る (複数 repo を一箇所へ集めたいとき用)。

log() { printf '[wt] %s\n' "$*"; }
die() {
  printf '[wt] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "${BASH_SOURCE[0]}"
  exit "${1:-0}"
}

# カレント (または引数のパス) が属するリポジトリの本体 checkout を特定する。
# git-common-dir は linked worktree から呼んでも常に本体の .git を指す。
resolve_repo() {
  local from="${1:-$PWD}" common_dir
  # command substitution をネストすると git の失敗を外側の dirname が握り潰すため、
  # git の結果を先に受け取り、戻り値を検査してから dirname を適用する。
  common_dir="$(git -C "$from" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    die "git リポジトリ内で実行する必要がある: $from"
  MAIN_ROOT="$(dirname "$common_dir")"
  REPO_NAME="$(basename "$MAIN_ROOT")"
  if [ -n "${WT_HOME:-}" ]; then
    WT_DIR="$WT_HOME/$REPO_NAME"
  else
    WT_DIR="$MAIN_ROOT/.claude/worktrees"
  fi
}

# worktree の置き場が repo 内 (WT_HOME 未設定) だと、本体の git status に未追跡で出る。
# git add . で worktree を巻き込む事故を避けるため一度案内する。対象は利用者の repo
# なので .gitignore は書き換えず、無視されていないときだけ知らせる。
warn_untracked_wt_dir() {
  case "$WT_DIR" in "$MAIN_ROOT"/*) ;; *) return 0 ;; esac
  git -C "$MAIN_ROOT" check-ignore -q "$WT_DIR" && return 0
  local rel="${WT_DIR#"$MAIN_ROOT"/}"
  log "注意: $rel/ は本体の git status に未追跡で出る。git add . で巻き込まないよう、"
  log "      本体の .gitignore か .git/info/exclude に '$rel/' を足しておく"
}

# wt が検証済みの herdr CLI 系列。herdr は 0.x の間、マイナー更新で CLI 契約が
# 変わる (0.7→0.8 で worktree create / agent start が非互換になった実績)。
# 系列外の herdr では途中で黙って壊れる代わりに herdr_ok で fail-fast する。
# herdr に追随したら tests/wt_test.sh の stub と一緒にこの値を上げる。
HERDR_SERIES="0.8"

# herdr のバージョンが検証済み系列か確かめる。バージョンを報告しない herdr は
# 判定しない (stub や旧版を殺さない)。WT_HERDR_SKIP_CHECK=1 で警告に緩和する
# (herdr 更新直後、wt の追随前に一時的に使うための逃げ道)。
check_herdr_series() {
  local v
  v="$(herdr --version 2>/dev/null | awk 'NR==1{print $NF}')" || true
  case "$v" in
    "" | "$HERDR_SERIES" | "$HERDR_SERIES".*) return 0 ;;
  esac
  if [ "${WT_HERDR_SKIP_CHECK:-0}" = "1" ]; then
    log "警告: herdr $v は未検証 (検証済み: $HERDR_SERIES 系)。CLI 契約が変わっていると壊れる"
    return 0
  fi
  die "herdr $v は wt の未検証バージョン (検証済み: $HERDR_SERIES 系)。herdr のマイナー更新は CLI 契約を壊すことがあるため中断する。wt を追随させて HERDR_SERIES を上げるか、一時的に WT_HERDR_SKIP_CHECK=1 で実行する"
}

# herdr サーバが起動していて socket API が使えるか。
# herdr が居るのに系列外なら false ではなく die する (silent fallback で
# git worktree だけ作られると、失敗と誤認した作り直しでブランチが衝突する)。
herdr_ok() {
  command -v herdr >/dev/null 2>&1 || return 1
  check_herdr_series
  herdr workspace list >/dev/null 2>&1
}

# cwd のブランチ worktree-<task> から task を推定する。
# worktree 側セッションで task 引数を省略したときに使う。
infer_task() { # cmdname
  local cur
  cur="$(git symbolic-ref --short -q HEAD 2>/dev/null || true)"
  case "$cur" in
    worktree-*) printf '%s' "${cur#worktree-}" ;;
    *) die "$1: task を指定する (worktree 外からは wt $1 <task>)" ;;
  esac
}

# Claude Code のセッションレジストリ (<config>/sessions/<pid>.json) の置き場。
# 各ファイルに cwd / name (セッション名) / kind / status が入っており、
# name がセッション間メッセージ (SendMessage) の宛先になる。
sessions_dir() {
  printf '%s/sessions' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

# 自分の祖先 pid を列挙する。wt を呼んだ Claude Code セッション本体を
# 特定して (self) を付けるために使う。ps が無ければ空を返し self 判定を諦める。
ancestor_pids() {
  local pid="${PPID:-0}" depth=0
  while [ "$depth" -lt 20 ]; do
    case "$pid" in '' | *[!0-9]*) return 0 ;; esac
    [ "$pid" -gt 1 ] || return 0
    printf '%s\n' "$pid"
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')" || return 0
    depth=$((depth + 1))
  done
}

# この repo に属する生存中の Claude Code セッションを列挙する。
# 本体 checkout は role=dev、worktree は role=<task>。cwd が worktree の
# サブディレクトリでも分類できるよう、パスは長い順の前方一致で照合する。
# 死んだセッションのレジストリファイルは残るため kill -0 で生存を確かめる。
cmd_peers() {
  local as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1 ;;
      -*) die "peers: 不明なオプション $1" ;;
      *) die "peers: 位置引数は取らない: $1" ;;
    esac
    shift
  done
  resolve_repo
  command -v jq >/dev/null 2>&1 || die "peers には jq が必要"

  local dir
  dir="$(sessions_dir)"
  [ -d "$dir" ] || die "Claude Code のセッションレジストリが無い: $dir"

  local pathmap
  pathmap="$(git -C "$MAIN_ROOT" worktree list --porcelain | awk -v main="$MAIN_ROOT" '
    function flush() {
      if (p == "") return
      role = (p == main) ? "dev" : (b ~ /^worktree-/ ? substr(b, 10) : "")
      if (role == "") { n = split(p, a, "/"); role = a[n] }
      printf "%d\t%s\t%s\n", length(p), p, role
    }
    /^worktree / { flush(); p = substr($0, 10); b = ""; next }
    /^branch /   { b = $2; sub(/^refs\/heads\//, "", b); next }
    END          { flush() }
  ' | sort -rn | cut -f2-)"

  local self_pids
  self_pids=" $(ancestor_pids | tr '\n' ' ') "

  local rows="" f pid meta cwd name kind status role selfmark p r
  for f in "$dir"/*.json; do
    [ -f "$f" ] || continue
    pid="${f##*/}"
    pid="${pid%.json}"
    case "$pid" in '' | *[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    meta="$(jq -r '[.cwd // "", .name // "", .kind // "", .status // ""] | @tsv' "$f" 2>/dev/null)" || continue
    IFS=$'\t' read -r cwd name kind status <<<"$meta" || continue
    [ -n "$cwd" ] || continue
    role=""
    while IFS=$'\t' read -r p r; do
      [ -n "$p" ] || continue
      case "$cwd/" in "$p"/*)
        role="$r"
        break
        ;;
      esac
    done <<<"$pathmap"
    [ -n "$role" ] || continue
    selfmark=no
    case "$self_pids" in *" $pid "*) selfmark=yes ;; esac
    rows="$rows$role	${name:--}	${kind:--}	${status:--}	$selfmark	$pid	$cwd
"
  done

  if [ "$as_json" -eq 1 ]; then
    printf '%s' "$rows" | jq -R -s 'split("\n") | map(select(length > 0) | split("\t")) |
      map({role: .[0], name: (if .[1] == "-" then null else .[1] end), kind: .[2],
           status: .[3], self: (.[4] == "yes"), pid: (.[5] | tonumber), cwd: .[6]})'
    return 0
  fi

  if [ -z "$rows" ]; then
    log "この repo の Claude Code セッションは見つからなかった"
    return 0
  fi
  printf '%-20s %-24s %-12s %-8s %-6s %s\n' ROLE NAME KIND STATUS SELF CWD
  printf '%s' "$rows" | while IFS=$'\t' read -r role name kind status selfmark _ cwd; do
    printf '%-20s %-24s %-12s %-8s %-6s %s\n' \
      "$role" "$name" "$kind" "$status" "$(if [ "$selfmark" = yes ]; then printf '(self)'; fi)" "$cwd"
  done
}

# worktree ブランチを削除する。未マージなら残して案内する (既存挙動)。
delete_branch() { # branch force
  local del_flag="-d"
  [ "$2" -eq 1 ] && del_flag="-D"
  git -C "$MAIN_ROOT" branch "$del_flag" "$1" ||
    log "ブランチ $1 は未マージのため残した (git branch -D $1 で削除可)"
}

# 本体の gitignore 済みファイルを worktree へ symlink する。
# 実体ファイルが既にある場合は上書きしない (worktree 固有の設定を尊重)。
link_shared() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    log "skip: $dst は実体があるため触らない"
    return 0
  fi
  ln -sfn "$src" "$dst"
  log "link: $dst -> $src"
}

# .worktreeinclude (repo root、gitignore 構文) に列挙された gitignore 済み
# ファイルを本体から worktree へ実体コピーする。既存ファイルは上書きしない。
# ディレクトリパターン (secrets/ 等) は git が中のファイルを個別列挙するので
# ファイル単位の mkdir -p + cp で済む。linked worktree は走査対象外。
copy_included() {
  local target="$1" inc="$MAIN_ROOT/.worktreeinclude"
  [ -f "$inc" ] || return 0
  local n=0 f src dst
  while IFS= read -r -d '' f; do
    src="$MAIN_ROOT/$f" dst="$target/$f"
    [ -e "$src" ] || [ -L "$src" ] || continue
    if [ -e "$dst" ] || [ -L "$dst" ]; then continue; fi
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
    n=$((n + 1))
  done < <(git -C "$MAIN_ROOT" ls-files -z --others --ignored --exclude-from="$inc")
  [ "$n" -gt 0 ] && log ".worktreeinclude: $n 件コピーした"
  return 0
}

# lockfile から package manager を検出して依存をインストールする
install_deps() {
  local target="$1"
  if [ -f "$target/package-lock.json" ]; then
    (cd "$target" && npm ci --prefer-offline --no-audit --no-fund)
  elif [ -f "$target/pnpm-lock.yaml" ]; then
    (cd "$target" && pnpm install --frozen-lockfile)
  elif [ -f "$target/yarn.lock" ]; then
    (cd "$target" && yarn install --immutable)
  elif [ -f "$target/bun.lock" ] || [ -f "$target/bun.lockb" ]; then
    (cd "$target" && bun install --frozen-lockfile)
  elif [ -f "$target/uv.lock" ]; then
    (cd "$target" && uv sync)
  else
    log "lockfile が見つからないため依存インストールをスキップした"
  fi
}

cmd_bootstrap() {
  local target="${1:-$PWD}"
  target="$(cd "$target" && pwd)"
  resolve_repo "$target"

  [ -f "$target/.git" ] || die "$target は linked worktree ではない"
  [ "$target" != "$MAIN_ROOT" ] || die "本体 checkout に bootstrap は不要"

  # .worktreeinclude の実体コピーを先に行う。.env が列挙されている repo では
  # コピーが優先され、後続の link_shared は既存ガードで symlink をスキップする。
  copy_included "$target"

  link_shared "$MAIN_ROOT/.env" "$target/.env"

  # Claude Code の許可設定を引き継ぐ (無ければ毎回プロンプトからやり直しになる)
  if [ -f "$MAIN_ROOT/.claude/settings.local.json" ] && [ ! -e "$target/.claude/settings.local.json" ]; then
    mkdir -p "$target/.claude"
    cp "$MAIN_ROOT/.claude/settings.local.json" "$target/.claude/"
    log "copy: .claude/settings.local.json"
  fi

  if [ -x "$target/scripts/worktree-setup" ]; then
    log "repo フック実行中: scripts/worktree-setup"
    (cd "$target" && WT_MAIN_ROOT="$MAIN_ROOT" WT_TARGET="$target" scripts/worktree-setup)
  else
    if [ ! -d "$target/node_modules" ]; then
      log "依存インストール中… ($target)"
      install_deps "$target"
    fi
  fi
  log "bootstrap 完了: $target"
}

cmd_new() {
  local task="" base="" start_claude=1 prompt="" prompt_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)
        [ $# -ge 2 ] || die "new: --base に値が必要"
        base="$2"
        shift
        ;;
      --no-claude) start_claude=0 ;;
      --prompt)
        [ $# -ge 2 ] || die "new: --prompt に値が必要"
        prompt="$2"
        shift
        ;;
      --prompt-file)
        [ $# -ge 2 ] || die "new: --prompt-file に値が必要"
        prompt_file="$2"
        shift
        ;;
      -*) die "new: 不明なオプション $1" ;;
      *)
        [ -n "$task" ] && die "new: 引数が多すぎる"
        task="$1"
        ;;
    esac
    shift
  done
  [ -n "$task" ] || usage 1
  # ディレクトリ名・ブランチ名に埋め込むので、パスやブランチ参照を壊さない文字に限る。
  [[ "$task" =~ ^[A-Za-z0-9._-]+$ ]] || die "task 名に使えるのは英数字と . _ - のみ: $task"

  # prompt の検証は worktree 作成の副作用が出る前に fail-fast する。
  # herdr 不可のまま進むと初期プロンプトを黙って取りこぼすため die する。
  if [ -n "$prompt" ] && [ -n "$prompt_file" ]; then
    die "new: --prompt と --prompt-file は併用できない"
  fi
  if [ -n "$prompt_file" ]; then
    [ -f "$prompt_file" ] || die "new: prompt ファイルが見つからない: $prompt_file"
    prompt="$(cat "$prompt_file")"
    [ -n "$prompt" ] || die "new: prompt ファイルが空: $prompt_file"
  fi
  if [ -n "$prompt" ]; then
    [ "$start_claude" -eq 1 ] || die "new: --prompt は --no-claude と併用できない"
    herdr_ok || die "new: herdr サーバなしでは Claude にプロンプトを渡せない (herdr を起動するか --prompt を外す)"
  fi
  resolve_repo
  # native worktree と揃えたブランチ名。task はディレクトリ名 / herdr ラベルに使う。
  local branch="worktree-$task"

  # base 省略時は本体 checkout の現在ブランチから分岐する
  if [ -z "$base" ]; then
    base="$(git -C "$MAIN_ROOT" symbolic-ref --short -q HEAD || echo HEAD)"
  fi
  git -C "$MAIN_ROOT" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null &&
    die "ブランチ $branch は既に存在する (wt open $task で開き直せる)"
  git -C "$MAIN_ROOT" rev-parse --verify --quiet "$base^{commit}" >/dev/null ||
    die "base ref が見つからない: $base"

  local path="$WT_DIR/$task" ws="" pane=""
  if herdr_ok; then
    local out
    out="$(herdr worktree create --cwd "$MAIN_ROOT" --branch "$branch" --base "$base" \
      --path "$path" --label "$task" --no-focus)"
    ws="$(jq -r '.result.workspace.workspace_id' <<<"$out")"
    # agent start は既存 pane を要求するため、workspace の root pane を押さえておく
    pane="$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")"
    path="$(jq -r '.result.worktree.path' <<<"$out")"
    log "worktree + workspace $ws 作成: $path ($branch ← $base)"
  else
    log "herdr サーバに接続できないため git worktree のみ作成する"
    git -C "$MAIN_ROOT" worktree add -b "$branch" "$path" "$base"
  fi

  cmd_bootstrap "$path"

  if [ -n "$ws" ] && [ "$start_claude" -eq 1 ]; then
    [ -n "$pane" ] ||
      die "new: workspace $ws の root pane を特定できなかった (herdr agent start に渡す pane が必要)"
    # 実行ファイルは --kind が決めるので argv には渡さない。-- 以降が claude の
    # 引数になり、prompt は argv 1 要素のまま渡る。
    # 起動フラグは WT_CLAUDE_ARGS で差し替え可能。単語分割で argv 化するため、
    # 空白を含む値 (引用符付きフラグ) はサポートしない。
    # -n はセッション名を wt-<task> に固定する。この名前が Claude Code の
    # セッション間メッセージ (SendMessage) の宛先になるため、dev 側は worktree の
    # task 名から宛先を決定できる (wt peers 参照)。WT_CLAUDE_ARGS に -n を
    # 含めれば後勝ちで上書きされる。
    local -a claude_args=(-n "wt-$task") claude_flags=()
    read -r -a claude_flags <<<"${WT_CLAUDE_ARGS---model opus --permission-mode auto}"
    [ "${#claude_flags[@]}" -gt 0 ] && claude_args+=("${claude_flags[@]}")
    [ -n "$prompt" ] && claude_args+=("$prompt")
    herdr agent start "claude-$task" --kind claude --pane "$pane" -- "${claude_args[@]}" >/dev/null ||
      die "new: Claude Code の起動に失敗した (herdr が古い場合は herdr update)"
    herdr workspace focus "$ws" >/dev/null
    log "Claude Code を workspace $ws で起動した"
  fi
  warn_untracked_wt_dir
  log "準備完了: $path"
}

cmd_open() {
  local task="${1:-}"
  [ -n "$task" ] || usage 1
  resolve_repo
  herdr_ok || die "herdr サーバに接続できない"
  local out ws branch="worktree-$task"
  out="$(herdr worktree open --cwd "$MAIN_ROOT" --branch "$branch" --label "$task" --no-focus)"
  ws="$(jq -r '.result.workspace.workspace_id' <<<"$out")"
  herdr workspace focus "$ws" >/dev/null
  log "workspace $ws で開いた: $task"
}

# ローカルファイルを既定のアプリで開く。開く手段はプラットフォームで違うので、
# skill 側に explorer.exe を直書きせずここに閉じ込める (WSL 専用にしない)。
cmd_browse() {
  local target="${1:-}"
  [ -n "$target" ] || usage 1
  [ -e "$target" ] || die "browse: ファイルが無い: $target"
  local abs
  abs="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"

  if command -v wslview >/dev/null 2>&1; then
    wslview "$abs" && return 0
  fi
  if command -v explorer.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
    # explorer.exe は成功時も非 0 を返すことがあるため終了状態を見ない。
    explorer.exe "$(wslpath -w "$abs")" >/dev/null 2>&1 || true
    return 0
  fi
  # Linux の open(1) は仮想端末の切り替えで別物なので、open は Darwin 限定で使う。
  if [ "$(uname -s)" = "Darwin" ] && command -v open >/dev/null 2>&1; then
    open "$abs" && return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$abs" >/dev/null 2>&1 && return 0
  fi
  die "browse: 開く手段が見つからない (wslview / explorer.exe / open / xdg-open)。手動で開いてください: $abs"
}

cmd_list() {
  resolve_repo
  git -C "$MAIN_ROOT" worktree list
  if herdr_ok; then
    echo "--- herdr workspaces ---"
    herdr worktree list --cwd "$MAIN_ROOT" |
      jq -r '.result.worktrees[] | select(.open_workspace_id) | "\(.open_workspace_id)\t\(.branch)\t\(.path)"'
  fi
}

cmd_rm() {
  local task="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      -*) die "rm: 不明なオプション $1" ;;
      *)
        [ -n "$task" ] && die "rm: 引数が多すぎる"
        task="$1"
        ;;
    esac
    shift
  done
  if [ -z "$task" ]; then
    task="$(infer_task rm)"
  fi
  resolve_repo

  local branch="worktree-$task" path
  # porcelain の worktree 行は "worktree <path>"。パスは空白を含み得るため
  # 列分割 ($2) ではなくプレフィックス長で切り出す。
  path="$(git -C "$MAIN_ROOT" worktree list --porcelain |
    awk -v b="refs/heads/$branch" '$1=="worktree"{p=substr($0,10)} $1=="branch" && $2==b{print p}')"
  [ -n "$path" ] || die "ブランチ $branch の worktree が見つからない"
  [ "$path" != "$MAIN_ROOT" ] || die "本体 checkout は削除できない"

  if [ "$force" -eq 0 ] && [ -n "$(git -C "$path" status --porcelain)" ]; then
    die "$path に未コミットの変更がある (--force で強制削除)"
  fi

  # 自己削除 (worktree 側セッションから自分を消す) なら cwd を退避する。
  # cwd が削除対象の中のままだと git が失敗する。
  local self=0
  case "$PWD/" in
    "$path"/*)
      self=1
      cd "$MAIN_ROOT"
      ;;
  esac

  local ws=""
  if herdr_ok; then
    ws="$(herdr worktree list --cwd "$MAIN_ROOT" |
      jq -r --arg p "$path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty')"
  fi

  if [ "$self" -eq 1 ] && [ -n "$ws" ]; then
    # 自己削除では herdr worktree remove (workspace close 込み) を使わない。
    # close の時点で自プロセス (claude → wt) が殺され、後続のブランチ削除が
    # 走らないため、git レベルの削除を先に済ませて close を最後の 1 手にする。
    if [ "$force" -eq 1 ]; then
      git -C "$MAIN_ROOT" worktree remove --force "$path"
    else
      git -C "$MAIN_ROOT" worktree remove "$path"
    fi
    delete_branch "$branch" "$force"
    log "worktree を削除した: $path (workspace $ws を閉じて終了する)"
    herdr workspace close "$ws" >/dev/null
    return 0
  fi

  if [ -n "$ws" ]; then
    if [ "$force" -eq 1 ]; then
      herdr worktree remove --workspace "$ws" --force >/dev/null
    else
      herdr worktree remove --workspace "$ws" >/dev/null
    fi
    log "workspace $ws と worktree を削除した"
  else
    if [ "$force" -eq 1 ]; then
      git -C "$MAIN_ROOT" worktree remove --force "$path"
    else
      git -C "$MAIN_ROOT" worktree remove "$path"
    fi
    log "worktree を削除した: $path"
  fi

  delete_branch "$branch" "$force"
}

# worktree ブランチ (worktree-<task>) を本体 checkout の現在ブランチへマージする。
# 主用途は worktree 内からの実行 (worktree 側の Claude が自分の成果を取り込む)。
# task 省略時は cwd のブランチから推定する。コンフリクトは本体側の working tree
# に発生し、auto-abort しない (解決 or merge --abort は呼び出し側が選ぶ)。
# マージ前に worktree の scripts/check (実行可能ファイル) を実行し、失敗したら
# マージしない。check は working tree に対して走る (未コミット変更も見える)。
cmd_merge() {
  local task="" run_check=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-check) run_check=0 ;;
      -*) die "merge: 不明なオプション $1" ;;
      *)
        [ -n "$task" ] && die "merge: 引数が多すぎる"
        task="$1"
        ;;
    esac
    shift
  done
  resolve_repo

  if [ -z "$task" ]; then
    task="$(infer_task merge)"
  fi
  local branch="worktree-$task"
  git -C "$MAIN_ROOT" rev-parse --verify -q "refs/heads/$branch" >/dev/null ||
    die "ブランチ $branch が存在しない (wt list で確認)"

  local main_branch
  main_branch="$(git -C "$MAIN_ROOT" symbolic-ref --short -q HEAD)" ||
    die "本体が detached HEAD のためマージできない"
  [ "$main_branch" != "$branch" ] || die "本体が $branch 自身を checkout している"

  # untracked は許容する (-uno)。worktree が .claude/worktrees に作られるため
  # 本体には常に untracked が現れ、素の porcelain では毎回中断してしまう。
  [ -z "$(git -C "$MAIN_ROOT" status --porcelain -uno)" ] ||
    die "本体 ($MAIN_ROOT) に未コミットの変更がある。commit / stash してから実行する"

  local wt_path
  # cmd_rm と同じく、空白を含み得るパスをプレフィックス長で切り出す
  wt_path="$(git -C "$MAIN_ROOT" worktree list --porcelain |
    awk -v b="refs/heads/$branch" '$1=="worktree"{p=substr($0,10)} $1=="branch" && $2==b{print p}')"
  if [ -n "$wt_path" ] && [ -n "$(git -C "$wt_path" status --porcelain)" ]; then
    log "警告: $wt_path に未コミットの変更がある (マージには含まれない)"
  fi

  if [ "$run_check" -eq 1 ]; then
    if [ -z "$wt_path" ]; then
      log "警告: worktree が無いため scripts/check をスキップした"
    elif [ -x "$wt_path/scripts/check" ]; then
      log "マージ前チェック実行中: scripts/check ($wt_path)"
      (cd "$wt_path" && scripts/check) ||
        die "scripts/check が失敗した。worktree 側で修正してから再実行する (wt merge --no-check で省略可)"
    elif [ -e "$wt_path/scripts/check" ]; then
      log "警告: scripts/check が実行可能でないためスキップした (chmod +x scripts/check)"
    else
      log "警告: scripts/check が無いためマージ前チェックをスキップした"
    fi
  fi

  if git -C "$MAIN_ROOT" merge --no-edit "$branch"; then
    log "マージ完了: $branch → $main_branch (片付けは wt rm $task)"
  else
    die "マージ失敗。本体のコンフリクトを解決して commit するか 'git -C $MAIN_ROOT merge --abort' で戻す"
  fi
}

case "${1:-}" in
  new)
    shift
    cmd_new "$@"
    ;;
  bootstrap)
    shift
    cmd_bootstrap "$@"
    ;;
  open)
    shift
    cmd_open "$@"
    ;;
  browse)
    shift
    cmd_browse "$@"
    ;;
  list)
    shift
    cmd_list "$@"
    ;;
  peers)
    shift
    cmd_peers "$@"
    ;;
  rm)
    shift
    cmd_rm "$@"
    ;;
  merge)
    shift
    cmd_merge "$@"
    ;;
  -h | --help | "") usage ;;
  *) die "不明なサブコマンド: $1 (--help 参照)" ;;
esac
